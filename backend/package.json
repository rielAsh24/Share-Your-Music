{
  "name": "backend",
  "version": "1.5.0",
  "description": "",
  "main": "./api/index.ts",
  "scripts": {
    "clean:install": "rm -rf node_modules",
    "clean:build": "rm -rf dist",
    "dev": "node --watch dist/index.js",
    "build": "tsc",
    "db:up": "docker compose up -d",
    "db:init": "node --experimental-strip-types ./tests/initTestData.js",
    "db:down": "docker compose down && docker volume rm backend_clubdb",
    "lint": "oxlint lint",
    "format": "prettier api/**/*.{ts,tsx} test/**/*.{ts,tsx} --write",
    "test": "jest"
  },
  "author": "Ashriel",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.1.4",
    "express": "^4.18.2",
    "express-session": "^1.18.0",
    "mongoose": "^8.2.0",
    "vercel": "^34.1.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2"
  }
}
